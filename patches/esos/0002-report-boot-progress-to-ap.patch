diff --git a/bsp/spacemit/drivers/board.c b/bsp/spacemit/drivers/board.c
index e7adc1831..f95329bee 100644
--- a/bsp/spacemit/drivers/board.c
+++ b/bsp/spacemit/drivers/board.c
@@ -10,6 +10,7 @@
 #include <dtb_node.h>
 #include <libfdt.h>
 #include <rtdevice.h>
+#include <riscv-ops.h>
 #include <spacemit_sdk_soc.h>
 #include <register_defination.h>
 #ifdef RT_USING_ARMSCP_MODULE
@@ -18,6 +19,20 @@
 
 extern unsigned char __bss_end__[];
 
+#define ESOS_BOOT_PROGRESS_MARK	0xd0000000
+
+static void esos_boot_trace(unsigned int stage)
+{
+	unsigned int hart_id = read_csr(mhartid);
+
+	if (hart_id == 0)
+		writel(ESOS_BOOT_PROGRESS_MARK | stage,
+		       (unsigned int *)RCPU_CORE1_BOOT_ENTRY_LO);
+	else
+		writel(ESOS_BOOT_PROGRESS_MARK | stage,
+		       (unsigned int *)RCPU_CORE0_BOOT_ENTRY_LO);
+}
+
 #if defined(RT_USING_CLK) && defined(RT_USING_MUTEX)
 struct rt_mutex clk_prepare_mutex;
 struct rt_mutex of_clk_mutex;
@@ -125,6 +140,8 @@ static void rt_hw_core_frequency_set(void)
  */
 void rt_hw_board_init(void)
 {
+	esos_boot_trace(2);
+
 #ifdef RT_USING_HEAP
     rt_system_heap_init((void *)RT_HEAP_START, (void *)RT_HEAP_END);
 #endif
@@ -153,6 +170,7 @@ void rt_hw_board_init(void)
 		}
 	  }
     }
+	esos_boot_trace(3);
 #endif
 
 #ifdef RT_USING_RADIX_TREE
@@ -208,6 +226,8 @@ void rt_hw_board_init(void)
     /* this framework will enable the tick timer */
     fwk_arch_init();
 #endif
+
+	esos_boot_trace(4);
 }
 
 /*@}*/
diff --git a/libcpu/risc-v/spacemit/rt24/startup_gcc.S b/libcpu/risc-v/spacemit/rt24/startup_gcc.S
index 416b0e6d4..ea5dd3ef6 100644
--- a/libcpu/risc-v/spacemit/rt24/startup_gcc.S
+++ b/libcpu/risc-v/spacemit/rt24/startup_gcc.S
@@ -42,6 +42,18 @@ _start:
 	li x30,0
 	li x31,0
 
+	/* Tell SPL that this core reached the first firmware instruction. */
+	csrr t0, mhartid
+	bnez t0, 1f
+	li t1, 0xc088008c
+	j 2f
+1:
+	li t1, 0xc088007c
+2:
+	li t2, 0xd0000001
+	sw t2, 0(t1)
+	fence iorw, iorw
+
 	/* set to disable FPU */
 	li t0, MSTATUS_FS
 	csrs mstatus, t0
