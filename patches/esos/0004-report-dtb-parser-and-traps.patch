diff --git a/libcpu/risc-v/spacemit/rt24/trap.c b/libcpu/risc-v/spacemit/rt24/trap.c
index 146a6a790..bcbc78226 100644
--- a/libcpu/risc-v/spacemit/rt24/trap.c
+++ b/libcpu/risc-v/spacemit/rt24/trap.c
@@ -11,6 +11,24 @@
 #include <rthw.h>
 #include <rtthread.h>
 #include <riscv_encoding.h>
+#include <riscv-ops.h>
+#include <register_defination.h>
+
+#define ESOS_TRAP_MARK 0xc0000000
+
+static void esos_report_trap(rt_size_t cause, rt_size_t epc)
+{
+    unsigned int hart_id = read_csr(mhartid);
+    unsigned long status_reg;
+
+    if (hart_id == 0)
+        status_reg = RCPU_CORE1_BOOT_ENTRY_LO;
+    else
+        status_reg = RCPU_CORE0_BOOT_ENTRY_LO;
+
+    writel((unsigned int)epc, (unsigned int *)(status_reg + sizeof(unsigned int)));
+    writel(ESOS_TRAP_MARK | (cause & 0xff), (unsigned int *)status_reg);
+}
 
 
