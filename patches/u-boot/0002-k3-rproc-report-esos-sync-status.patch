diff --git a/drivers/remoteproc/k3-rproc.c b/drivers/remoteproc/k3-rproc.c
index 8e99be17d42..53d5f581f75 100644
--- a/drivers/remoteproc/k3-rproc.c
+++ b/drivers/remoteproc/k3-rproc.c
@@ -20,6 +20,18 @@
 #define RCPU_CORE1_BOOT_ENTRY_HI	0xc0880090
 #define RCPU_CORE1_HART_ID_SET		0xc0880094
 
+/*
+ * The remote core signals "my RPMI service is up" by writing a non-zero value
+ * into the *other* core's boot-entry register, which we cleared just before
+ * waking it (see rt_hw_rpmi_init() in the ESOS firmware).  Plain 1 means OK;
+ * a value carrying RCPU_SYNC_ERR_MARK means ESOS gave up during its RPMI
+ * bring-up and put the failing step in the low byte, so we get a diagnosis
+ * instead of a silent six second stall.
+ */
+#define RCPU_SYNC_OK			0x00000001
+#define RCPU_SYNC_ERR_MARK		0xe0000000
+#define RCPU_SYNC_ERR_MASK		0xf0000000
+
 #define RCPU_EXECUTION_CTRL		0xc088c030
 
 #define RCPU_PWR_DOMAIN_STAT_REG	0xd42828f0
@@ -97,6 +109,7 @@ static int k3_rproc_start(struct udevice *dev)
 {
 	int try_count = 6000;
 	struct k3_rproc_privdata *priv;
+	u32 sync;
 
 	priv = dev_get_priv(dev);
 
@@ -125,8 +138,16 @@ static int k3_rproc_start(struct udevice *dev)
 			mdelay(1);
 		}
 
-		if (try_count <= 0)
+		sync = readl((void __iomem *)RCPU_CORE1_BOOT_ENTRY_LO);
+		if (try_count <= 0) {
 			dev_err(dev, "try start rproc-0 failed\n");
+			printf("rproc-0: ESOS never signalled ready (waited 6000 ms)\n");
+		} else if ((sync & RCPU_SYNC_ERR_MASK) == RCPU_SYNC_ERR_MARK) {
+			printf("rproc-0: ESOS RPMI init failed at step %u (sync=0x%08x)\n",
+			       sync & 0xff, sync);
+		} else {
+			printf("rproc-0: ESOS ready (sync=0x%08x)\n", sync);
+		}
 
 		break;
 
@@ -154,8 +175,16 @@ static int k3_rproc_start(struct udevice *dev)
 			mdelay(1);
 		}
 
-		if (try_count <= 0)
+		sync = readl((void __iomem *)RCPU_CORE0_BOOT_ENTRY_LO);
+		if (try_count <= 0) {
 			dev_err(dev, "try start rproc-1 failed\n");
+			printf("rproc-1: ESOS never signalled ready (waited 6000 ms)\n");
+		} else if ((sync & RCPU_SYNC_ERR_MASK) == RCPU_SYNC_ERR_MARK) {
+			printf("rproc-1: ESOS RPMI init failed at step %u (sync=0x%08x)\n",
+			       sync & 0xff, sync);
+		} else {
+			printf("rproc-1: ESOS ready (sync=0x%08x)\n", sync);
+		}
 		break;
 
 	default:
